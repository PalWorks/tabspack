{
  "manifest_version": 3,
  "name": "TabsPack",
  "version": "0.0.1",
  "description": "Export, move, share and restore browser tabs across browsers using an open, offline first format.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TabsPack",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "downloads"
  ],
  "optional_permissions": [
    "tabGroups"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "commands": {
    "export-all-windows": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Export all windows to a TabsPack file"
    },
    "export-current-window": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Export this window to a TabsPack file"
    },
    "save-snapshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save a snapshot of every window"
    }
  }
}
