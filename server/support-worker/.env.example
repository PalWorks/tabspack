# Copy to `.env` and fill in. Neither of these is a credential; they are kept
# out of the repository because a public repo has no reason to name the account
# anything runs on. The only actual secret, the Resend key, is never in a file
# here at all: it lives in Cloudflare, set with `wrangler secret put`.

# `npx wrangler whoami` lists the accounts and their ids.
CLOUDFLARE_ACCOUNT_ID=

# Printed by `npx wrangler kv namespace create tabspack-support-counters`, and
# listed by `npx wrangler kv namespace list`.
COUNTERS_KV_ID=
