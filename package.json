{
  "name": "tabspack",
  "version": "0.0.1",
  "private": true,
  "description": "Export, move, share and restore browser tabs across browsers using an open, offline first format",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/test.mjs",
    "schema": "node scripts/gen-schema.mjs",
    "schema:check": "node scripts/gen-schema.mjs --check",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "perf": "node scripts/perf.mjs",
    "verify": "npm run typecheck && npm run lint && npm run schema:check && npm test && npm run perf && npm run build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "webextension-polyfill": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "esbuild": "0.25.0",
    "ts-json-schema-generator": "2.3.0",
    "typescript": "5.7.3"
  }
}
